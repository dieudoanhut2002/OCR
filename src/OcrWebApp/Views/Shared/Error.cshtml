@{
    ViewData["Title"] = "Có lỗi xảy ra";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 text-center">
        <div class="card border-0 shadow-sm rounded-4 p-5">
            <div class="text-danger mb-3">
                <i class="bi bi-exclamation-triangle-fill display-1"></i>
            </div>
            <h3 class="fw-bold text-dark mb-2">Đã xảy ra lỗi trong quá trình xử lý</h3>
            <p class="text-muted mb-4">
                Hệ thống đã ghi nhận sự cố này vào nhật ký bảo mật. Vui lòng kiểm tra lại tài liệu tải lên hoặc thử lại sau ít phút.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">
                    <i class="bi bi-house me-1"></i> Về trang chủ
                </a>
                <a asp-controller="Job" asp-action="History" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-clock-history me-1"></i> Xem lịch sử
                </a>
            </div>
        </div>
    </div>
</div>
