@model HomeViewModel
@{
    ViewData["Title"] = "Nhận diện văn bản OCR";
}

<div class="row g-4">
    <!-- Left Column: Upload & Options -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-primary-subtle text-primary p-2 rounded-circle me-3">
                        <i class="bi bi-cloud-arrow-up-fill fs-4"></i>
                    </div>
                    <div>
                        <h4 class="card-title mb-0 fw-bold">Tải lên tài liệu hoặc ảnh</h4>
                        <p class="text-muted small mb-0">Hỗ trợ JPG, PNG, TIFF và tài liệu PDF đa trang</p>
                    </div>
                </div>

                <!-- Drag & Drop Zone -->
                <div id="dropZone" class="drop-zone p-5 text-center rounded-3 border border-2 border-dashed bg-light mb-3">
                    <i class="bi bi-file-earmark-arrow-up text-primary display-4 mb-3 d-block"></i>
                    <h5 class="fw-semibold text-dark mb-1">Kéo và thả file vào đây</h5>
                    <p class="text-muted small mb-3">hoặc sử dụng nút bên dưới để chọn file từ máy tính</p>
                    
                    <input type="file" id="fileInput" multiple accept=".jpg,.jpeg,.png,.tiff,.tif,.pdf" class="d-none" />
                    <button type="button" class="btn btn-outline-primary px-4 fw-medium" onclick="document.getElementById('fileInput').click()">
                        <i class="bi bi-folder2-open me-2"></i> Chọn file từ thiết bị
                    </button>
                    <div class="mt-3">
                        <span class="badge bg-secondary-subtle text-secondary me-1">JPG / PNG / TIFF</span>
                        <span class="badge bg-secondary-subtle text-secondary me-1">PDF đa trang</span>
                        <span class="badge bg-info-subtle text-info me-1"><i class="bi bi-hdd me-1"></i> Tối đa 25MB</span>
                        <span class="badge bg-warning-subtle text-warning me-1"><i class="bi bi-file-earmark-break me-1"></i> Tối đa 50 trang</span>
                        <span class="badge bg-danger-subtle text-danger"><i class="bi bi-clock-history me-1"></i> Tự xóa sau 24h</span>
                    </div>
                </div>

                <!-- Selected Files List -->
                <div id="fileListContainer" class="d-none mb-3">
                    <h6 class="fw-bold text-dark d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-list-check me-1"></i> Danh sách file đã chọn (<span id="fileCount">0</span>)</span>
                        <button type="button" class="btn btn-link btn-sm text-danger text-decoration-none p-0" id="clearFilesBtn">
                            <i class="bi bi-trash3 me-1"></i> Xóa tất cả
                        </button>
                    </h6>
                    <div class="table-responsive border rounded bg-white" style="max-height: 220px; overflow-y: auto;">
                        <table class="table table-hover table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Tên file</th>
                                    <th>Định dạng</th>
                                    <th>Dung lượng</th>
                                    <th class="text-end">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody id="fileListBody"></tbody>
                        </table>
                    </div>
                </div>

                <!-- OCR Configuration Options -->
                <div class="card bg-light border-0 rounded-3 p-3 mb-4">
                    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-sliders me-1"></i> Tùy chọn cấu hình OCR</h6>
                    
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Ngôn ngữ nhận diện:</label>
                            <select id="ocrLanguage" class="form-select form-select-sm mb-2">
                                <option value="vie" selected>Tiếng Việt (vie)</option>
                                <option value="eng">Tiếng Anh (eng)</option>
                                <option value="vie+eng">Cả tiếng Việt và tiếng Anh (vie+eng)</option>
                            </select>

                            <label class="form-label small fw-semibold">Chọn dải trang (Tùy chọn cho PDF):</label>
                            <input type="text" id="pageRangeInput" class="form-control form-control-sm" placeholder="VD: 1-5, 8 (để trống: tất cả trang)" />
                            <div class="form-text small">Tối đa 50 trang mỗi tài liệu để tối ưu tốc độ.</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Tiền xử lý nâng cao:</label>
                            <div class="form-check form-switch small">
                                <input class="form-check-input" type="checkbox" id="preprocessGrayscale" checked />
                                <label class="form-check-label" for="preprocessGrayscale">Chuyển ảnh sang thang xám (Grayscale)</label>
                            </div>
                            <div class="form-check form-switch small">
                                <input class="form-check-input" type="checkbox" id="preprocessContrast" checked />
                                <label class="form-check-label" for="preprocessContrast">Tăng độ tương phản (Contrast)</label>
                            </div>
                            <div class="form-check form-switch small">
                                <input class="form-check-input" type="checkbox" id="preprocessDeskew" />
                                <label class="form-check-label" for="preprocessDeskew">Tự động xoay thẳng góc (Auto Deskew)</label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Start OCR Button -->
                <div class="d-grid">
                    <button type="button" id="startOcrBtn" class="btn btn-primary btn-lg fw-bold shadow-sm" disabled>
                        <i class="bi bi-play-circle-fill me-2"></i> Bắt đầu nhận diện (Start OCR)
                    </button>
                </div>
            </div>
        </div>

        <!-- Live Processing Progress Card -->
        <div id="processingCard" class="card border-0 shadow-sm rounded-3 d-none">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold text-primary">
                    <span class="spinner-border spinner-border-sm me-2" role="status" id="batchSpinner"></span>
                    Tiến trình nhận diện OCR
                </h6>
                <span id="batchSummaryBadge" class="badge bg-primary">Đang xử lý...</span>
            </div>
            <div class="card-body p-3">
                <div class="progress mb-3" style="height: 10px;">
                    <div id="globalProgressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 0%"></div>
                </div>
                <div id="batchJobsList" class="list-group list-group-flush border rounded"></div>
            </div>
        </div>
    </div>

    <!-- Right Column: Instructions & Recent Jobs -->
    <div class="col-lg-5">
        <!-- Highlights & Engine Info -->
        <div class="card border-0 shadow-sm rounded-3 mb-4 bg-primary text-white">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-lightning-charge-fill fs-4"></i>
                    <h5 class="fw-bold mb-0">Hệ thống OCR độc lập</h5>
                </div>
                <p class="small text-white-50 mb-3">
                    Hoạt động 100% độc lập không cần gửi dữ liệu qua các API tính phí của bên thứ ba.
                </p>
                <ul class="list-unstyled small mb-0">
                    <li class="mb-2"><i class="bi bi-check2-circle me-2"></i> <strong>PDF thông minh:</strong> Tự nhận diện text layer có sẵn hoặc render quét OCR.</li>
                    <li class="mb-2"><i class="bi bi-check2-circle me-2"></i> <strong>Độ tin cậy:</strong> Cung cấp chỉ số confidence score cho từng từ/trang.</li>
                    <li class="mb-2"><i class="bi bi-check2-circle me-2"></i> <strong>Xem song song:</strong> Đối chiếu tài liệu gốc và kết quả OCR trực quan.</li>
                    <li class="mb-0"><i class="bi bi-check2-circle me-2"></i> <strong>Xuất dữ liệu:</strong> Tải kết quả dạng TXT, Word DOCX hoặc PDF.</li>
                </ul>
            </div>
        </div>

        <!-- Recent Jobs In Session -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-clock-history me-1"></i> Tác vụ gần đây trong phiên</h6>
                <a asp-controller="Job" asp-action="History" class="btn btn-outline-secondary btn-sm py-0">Xem tất cả</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentJobs.Count == 0)
                {
                    <div class="p-4 text-center text-muted">
                        <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                        <p class="small mb-0">Chưa có tác vụ OCR nào trong phiên này. Hãy tải file để bắt đầu!</p>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var job in Model.RecentJobs)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center p-3">
                                <div class="me-2 text-truncate" style="max-width: 240px;">
                                    <div class="fw-semibold text-truncate" title="@job.OriginalFileName">
                                        <i class="bi bi-file-earmark-text text-primary me-1"></i> @job.OriginalFileName
                                    </div>
                                    <div class="text-muted small">
                                        @job.CreatedAtUtc.ToLocalTime().ToString("HH:mm dd/MM") &bull; @(job.FileSizeBytes / 1024) KB
                                        @if (job.AverageConfidence.HasValue)
                                        {
                                            <span> &bull; <strong class="text-success">@job.AverageConfidence.Value.ToString("F0")%</strong></span>
                                        }
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    @if (job.Status == OcrJobStatus.Completed)
                                    {
                                        <span class="badge bg-success-subtle text-success">Hoàn tất</span>
                                        <a asp-controller="Job" asp-action="Detail" asp-route-id="@job.Id" class="btn btn-sm btn-outline-primary" title="Xem & chỉnh sửa">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    }
                                    else if (job.Status == OcrJobStatus.Processing)
                                    {
                                        <span class="badge bg-warning-subtle text-warning">Đang xử lý</span>
                                        <a asp-controller="Job" asp-action="Detail" asp-route-id="@job.Id" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-arrow-repeat"></i>
                                        </a>
                                    }
                                    else if (job.Status == OcrJobStatus.Failed)
                                    {
                                        <span class="badge bg-danger-subtle text-danger">Thất bại</span>
                                        <a asp-controller="Job" asp-action="Detail" asp-route-id="@job.Id" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-exclamation-circle"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Chờ xử lý</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/ocr-upload.js" asp-append-version="true"></script>
}
