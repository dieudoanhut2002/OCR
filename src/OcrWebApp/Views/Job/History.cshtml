@model JobHistoryViewModel
@{
    ViewData["Title"] = "Lịch sử xử lý OCR";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-clock-history text-primary me-2"></i> Lịch sử xử lý OCR</h3>
        <p class="text-muted small mb-0">Quản lý và tải lại kết quả các tài liệu đã nhận diện trong phiên làm việc của bạn</p>
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary fw-medium">
        <i class="bi bi-plus-circle me-1"></i> Nhận diện file mới
    </a>
</div>

<!-- Stats Counter Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-3 p-3">
            <div class="text-muted small fw-semibold">Tổng số công việc</div>
            <div class="fs-3 fw-bold text-dark">@Model.TotalJobs</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 border-start border-success border-4">
            <div class="text-muted small fw-semibold">Đã hoàn thành</div>
            <div class="fs-3 fw-bold text-success">@Model.CompletedJobs</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 border-start border-warning border-4">
            <div class="text-muted small fw-semibold">Đang xử lý / chờ</div>
            <div class="fs-3 fw-bold text-warning">@Model.ProcessingJobs</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 border-start border-danger border-4">
            <div class="text-muted small fw-semibold">Thất bại</div>
            <div class="fs-3 fw-bold text-danger">@Model.FailedJobs</div>
        </div>
    </div>
</div>

<!-- Jobs Table -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        @if (Model.Jobs.Count == 0)
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-journal-x display-4 text-secondary mb-3 d-block"></i>
                <h5 class="fw-bold text-dark">Chưa có lịch sử công việc nào</h5>
                <p class="small mb-3">Tất cả các tài liệu bạn tải lên sẽ hiển thị và lưu trữ riêng tại đây.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-cloud-arrow-up me-1"></i> Tải tài liệu đầu tiên
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Tên tài liệu</th>
                            <th>Định dạng</th>
                            <th>Dung lượng</th>
                            <th>Ngôn ngữ</th>
                            <th>Độ tin cậy</th>
                            <th>Trạng thái</th>
                            <th>Thời gian</th>
                            <th class="text-end pe-3">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in Model.Jobs)
                        {
                            <tr id="jobRow-@job.Id">
                                <td class="ps-3">
                                    <div class="fw-semibold text-truncate" style="max-width: 250px;" title="@job.OriginalFileName">
                                        <i class="bi bi-file-earmark-text text-primary me-1"></i> @job.OriginalFileName
                                    </div>
                                    <div class="text-muted small">@job.TotalPages trang</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(System.IO.Path.GetExtension(job.OriginalFileName)?.TrimStart('.').ToUpperInvariant() ?? "")
                                    </span>
                                </td>
                                <td class="small text-muted">@(job.FileSizeBytes / 1024) KB</td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary">@job.Language</span>
                                </td>
                                <td>
                                    @if (job.AverageConfidence.HasValue)
                                    {
                                        var conf = job.AverageConfidence.Value;
                                        var badgeColor = conf >= 80 ? "text-success" : (conf >= 60 ? "text-warning" : "text-danger");
                                        <strong class="@badgeColor">@conf.ToString("F1")%</strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">--</span>
                                    }
                                </td>
                                <td>
                                    @if (job.Status == OcrJobStatus.Completed)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="bi bi-check-circle me-1"></i> Hoàn thành
                                        </span>
                                    }
                                    else if (job.Status == OcrJobStatus.Processing)
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                            Đang xử lý (@job.ProcessedPages/@job.TotalPages)
                                        </span>
                                    }
                                    else if (job.Status == OcrJobStatus.Pending)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                            <i class="bi bi-hourglass me-1"></i> Hàng đợi
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle" title="@job.ErrorMessage">
                                            <i class="bi bi-x-circle me-1"></i> Thất bại
                                        </span>
                                    }
                                </td>
                                <td class="small text-muted">
                                    @job.CreatedAtUtc.ToLocalTime().ToString("HH:mm dd/MM/yyyy")
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Detail" asp-route-id="@job.Id" class="btn btn-outline-primary" title="Xem chi tiết & Chỉnh sửa">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        @if (job.Status == OcrJobStatus.Completed)
                                        {
                                            <a asp-action="Export" asp-route-id="@job.Id" asp-route-format="txt" class="btn btn-outline-secondary" title="Tải file TXT">
                                                <i class="bi bi-filetype-txt"></i>
                                            </a>
                                            <a asp-action="Export" asp-route-id="@job.Id" asp-route-format="docx" class="btn btn-outline-secondary" title="Tải file DOCX">
                                                <i class="bi bi-filetype-docx"></i>
                                            </a>
                                            <a asp-action="Export" asp-route-id="@job.Id" asp-route-format="pdf" class="btn btn-outline-secondary" title="Tải file PDF">
                                                <i class="bi bi-filetype-pdf"></i>
                                            </a>
                                        }

                                        @if (job.Status == OcrJobStatus.Failed)
                                        {
                                            <button type="button" class="btn btn-outline-warning retry-btn" data-job-id="@job.Id" title="Thử lại">
                                                <i class="bi bi-arrow-clockwise"></i>
                                            </button>
                                        }

                                        <button type="button" class="btn btn-outline-danger delete-btn" data-job-id="@job.Id" title="Xóa tài liệu">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';

            // Handle Delete
            document.querySelectorAll('.delete-btn').forEach(btn => {
                btn.addEventListener('click', async () => {
                    if (!confirm('Bạn có chắc chắn muốn xóa tài liệu này cùng toàn bộ dữ liệu liên quan?')) return;
                    const jobId = btn.getAttribute('data-job-id');

                    try {
                        const res = await fetch(`/Job/Delete/${jobId}`, {
                            method: 'POST',
                            headers: { 'X-CSRF-TOKEN': csrfToken }
                        });
                        const data = await res.json();
                        if (data.success) {
                            const row = document.getElementById(`jobRow-${jobId}`);
                            if (row) row.remove();
                        } else {
                            alert(data.message || 'Lỗi khi xóa tài liệu.');
                        }
                    } catch (e) {
                        alert('Lỗi kết nối máy chủ khi xóa.');
                    }
                });
            });

            // Handle Retry
            document.querySelectorAll('.retry-btn').forEach(btn => {
                btn.addEventListener('click', async () => {
                    const jobId = btn.getAttribute('data-job-id');
                    try {
                        const res = await fetch(`/Job/Retry/${jobId}`, {
                            method: 'POST',
                            headers: { 'X-CSRF-TOKEN': csrfToken }
                        });
                        const data = await res.json();
                        if (data.success) {
                            window.location.reload();
                        } else {
                            alert(data.message || 'Lỗi khi đưa vào hàng đợi.');
                        }
                    } catch (e) {
                        alert('Lỗi kết nối máy chủ khi thử lại.');
                    }
                });
            });
        });
    </script>
}
