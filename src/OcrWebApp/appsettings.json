{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=OcrDocumentDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "OcrSettings": {
    "StoragePath": "App_Data/Uploads",
    "TessdataPath": "tessdata",
    "MaxFileSizeBytes": 26214400,
    "MaxPdfPages": 50,
    "RetentionHours": 24,
    "AutoCleanupEnabled": true,
    "CleanupIntervalMinutes": 60,
    "ProcessingTimeoutSeconds": 300,
    "ConcurrencyLimit": 2,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".tiff", ".tif", ".pdf" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
